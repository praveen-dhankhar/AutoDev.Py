OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_BASE_URL=http://localhost:11434
MAX_RETRIES=3
SUBPROCESS_TIMEOUT=30
AGENT_CALL_TIMEOUT=60
WORKSPACE_DIR=./workspace
LOG_LEVEL=INFO
SANDBOX_IMAGE=autodev-py-sandbox:latest
SANDBOX_ALLOW_NETWORK=0
# Hosted model instead of Ollama, e.g. openai/gpt-4o-mini or gemini/gemini-2.0-flash.
# Needs OPENAI_API_KEY or GEMINI_API_KEY.
LLM_MODEL=
# Ollama embedding model for long-term fix memory.
EMBED_MODEL=nomic-embed-text
# FastAPI service: bearer token (empty disables auth) and concurrent job cap.
API_TOKEN=
MAX_CONCURRENT_JOBS=2
